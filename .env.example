RAG_DATA_DIR=./data
# Gemini alternative: uncomment both lines and add the actual key only in .env.
# Gemini settings take precedence over the Hugging Face / compatible settings below.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Copy this file to .env and put your token there, never in this example file.
# HF token needs the "Make calls to Inference Providers" permission.
HF_TOKEN=HF_Token_Key
RAG_LLM_BASE_URL=https://router.huggingface.co/v1
RAG_LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# Model availability depends on the provider; change RAG_LLM_MODEL as needed.
# For a different compatible endpoint, use RAG_LLM_API_KEY instead of HF_TOKEN.
# RAG_LLM_API_KEY=
# Local Ollama alternative: install Ollama, then run `ollama pull qwen2.5:3b`.
# RAG_LLM_BASE_URL=http://127.0.0.1:11434/v1
# RAG_LLM_MODEL=qwen2.5:3b
# RAG_LLM_TIMEOUT=120
RAG_MAX_UPLOAD_MB=10
RAG_SIMILARITY_THRESHOLD=0.3
